{
  "_comment": [
    "Built-in model registry. Prices are rough USD estimates per output image (checked 2026-11-05);",
    "fal's dashboard is authoritative. Extend or override in ~/.config/falg/models.json or in a",
    "job config under \"model_defs\" (same shape; entries are merged per model and per mode).",
    "size modes: px = image_size {width,height} from aspect + target pixel count (multiple of 16);",
    "aspect = aspect_ratio param (resolution goes in params); enum = image_size from enum_map; none.",
    "batch = send num_images in one request; max_batch = the endpoint's num_images maximum (from",
    "`falg schema`); larger n is split into several requests. Without max_batch, falg assumes 4."
  ],
  "seedream-5-pro": {
    "note": "ByteDance flagship (Jul 2026), ~4.6 MP max",
    "generate": {"endpoint": "bytedance/seedream/v5/pro/text-to-image", "price": 0.135, "default": true,
                 "size": "px", "pixels": 4596736, "batch": true, "max_batch": 6, "params": {"output_format": "png"}},
    "edit": {"endpoint": "bytedance/seedream/v5/pro/edit", "price": 0.14,
             "size": "none", "params": {"output_format": "png", "image_size": "auto_2K"}}
  },
